{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "樱花动漫示例 Provider 配置",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "mirrors",
    "maxCandidates",
    "preferredLines",
    "requestTimeoutMs",
    "minimumRequestIntervalMs",
    "maximumRequestsPerOperation",
    "maximumResponseBytes"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "mirrors": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "baseUrl", "enabled", "priority"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9-]+$"
          },
          "baseUrl": {
            "type": "string",
            "format": "uri",
            "pattern": "^https://"
          },
          "enabled": {
            "type": "boolean"
          },
          "priority": {
            "type": "integer",
            "minimum": -1000,
            "maximum": 1000
          }
        }
      }
    },
    "maxCandidates": {
      "type": "integer",
      "minimum": 1,
      "maximum": 5
    },
    "preferredLines": {
      "type": "array",
      "maxItems": 16,
      "items": {
        "type": "string",
        "maxLength": 64
      }
    },
    "requestTimeoutMs": {
      "type": "integer",
      "minimum": 1000,
      "maximum": 60000
    },
    "minimumRequestIntervalMs": {
      "type": "integer",
      "minimum": 250,
      "maximum": 10000
    },
    "maximumRequestsPerOperation": {
      "type": "integer",
      "minimum": 1,
      "maximum": 16
    },
    "maximumResponseBytes": {
      "type": "integer",
      "minimum": 65536,
      "maximum": 8388608
    }
  }
}
